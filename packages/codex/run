#!/usr/bin/env python3
"""run: one turn of Codex. It reads the Responses request, starts Codex headless (`codex exec --json`), and prints
what it does as Responses output: each message, each command it ran and each file it changed as an output item,
and the stream's last event, with the tokens the turn used."""
import json
import os
import signal
import subprocess
import uuid

HARNESS, TURN = os.environ["HG_HARNESS"], os.environ["HG_TURN"]
SESSION = os.path.join(os.environ["HG_STATE"], "session")      # Codex's own id for this session: its thread id


def say(line):
    print(json.dumps(line), flush=True)


def step(item):
    """One thing Codex finished, as the output item of that kind."""
    call = {"call_id": f"call_{uuid.uuid4().hex}", "status": "completed"}
    if item["type"] == "agent_message":
        say({"type": "message", "role": "assistant", "status": "completed",
             "content": [{"type": "output_text", "text": item["text"], "annotations": []}]})
    elif item["type"] == "reasoning":
        say({"type": "reasoning", "summary": [{"type": "summary_text", "text": item.get("text", "")}]})
    elif item["type"] == "command_execution":
        say({"type": "shell_call", **call, "action": {"commands": [item["command"]]}})
        say({"type": "shell_call_output", **call, "output": [{
            "stdout": item.get("aggregated_output", ""), "stderr": "",
            "outcome": {"type": "exit", "exit_code": int(item.get("exit_code") or 0)}}]})
    elif item["type"] == "file_change":                # Codex says which files changed and how, not what changed
        for change in item.get("changes") or []:
            kind = {"add": "create_file", "delete": "delete_file"}.get(change.get("kind"), "update_file")
            call = {"call_id": f"call_{uuid.uuid4().hex}", "status": "completed"}
            say({"type": "apply_patch_call", **call, "operation": {
                "type": kind, "path": change.get("path", ""), **({} if kind == "delete_file" else {"diff": ""})}})
            say({"type": "apply_patch_call_output", **call})
    elif item["type"] != "error":                      # an error item is a warning: the turn's end says if it failed
        say({"type": "custom_tool_call", "call_id": call["call_id"], "name": item["type"], "input": json.dumps(item)})
        say({"type": "custom_tool_call_output", **call, "output": ""})


with open(os.path.join(TURN, "request.json"), encoding="utf-8") as file:
    request = json.load(file)
if "HG_PROVIDER_OPENAI_RESPONSES" not in os.environ:   # Codex speaks one API: the provider must speak it too
    say({"type": "response.failed", "response": {"error": {"code": "no_provider", "message": (
        "Codex needs a provider that speaks the OpenAI Responses API: name one, as codex/provider/model.")}}})
    raise SystemExit
given = request["input"]
prompt = given if isinstance(given, str) else "\n\n".join(
    part["text"] for item in given if item.get("role") == "user" and isinstance(item.get("content"), list)
    for part in item["content"] if part.get("type") == "input_text")
provider = {"name": "hg", "base_url": os.environ["HG_PROVIDER_OPENAI_RESPONSES"], "env_key": "HG_PROVIDER_KEY",
            "wire_api": "responses"}
settings = ["-c", "model_provider=hg", "-c", "model_providers.hg={" + ",".join(
    f"{name}={json.dumps(value)}" for name, value in provider.items()) + "}", "-m", os.environ["HG_MODEL"]]
resume = ["resume", open(SESSION, encoding="utf-8").read()] if os.path.exists(SESSION) else []
if request.get("instructions") and not resume:
    settings += ["-c", f"developer_instructions={json.dumps(request['instructions'])}"]
elif request.get("instructions"):                      # Codex takes instructions only when a session begins: on a
    prompt = (f"Instructions for this turn, which replace any given before:\n{request['instructions']}"   # resumed
              f"\n\n{prompt}")                         # one they are ignored, so they go with the prompt
args = [os.path.join(HARNESS, "tools", "node_modules", ".bin", "codex"), "exec", *resume, "--json",
        "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", *settings, "-"]
signal.signal(signal.SIGTERM, lambda *_: None)         # a stopped turn: outlive Codex, so it saves its session
cli = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, errors="replace")
cli.stdin.write(prompt)
cli.stdin.close()
usage, error, ended = None, None, False
for line in cli.stdout:
    try:
        event = json.loads(line)
    except ValueError:
        continue
    kind = event.get("type")
    if kind == "thread.started":
        os.makedirs(os.path.dirname(SESSION), exist_ok=True)
        with open(SESSION, "w", encoding="utf-8") as file:
            file.write(event["thread_id"])             # kept at once: a stopped turn is continued too
    elif kind == "item.completed":
        step(event["item"])
    elif kind == "turn.completed":
        counted, ended = event.get("usage") or {}, True
        usage = {"input_tokens": counted.get("input_tokens", 0), "output_tokens": counted.get("output_tokens", 0),
                 "input_tokens_details": {"cached_tokens": counted.get("cached_input_tokens", 0)}}
    elif kind in ("turn.failed", "error"):
        error = (event.get("error") or {}).get("message") or event.get("message") or "Codex reported an error"
code = cli.wait()
if ended and not error:
    say({"type": "response.completed", "response": {"usage": usage}})
else:
    say({"type": "response.failed", "response": {"error": {
        "code": "cli_error", "message": str(error or f"Codex exited with code {code} without a result.")[:2000]}}})

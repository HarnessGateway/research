#!/bin/sh
# install: Codex at a pinned version, by its makers' own method (npm), under $HG_HARNESS/tools.
set -eu
VERSION=0.171.0
npm install --prefix "$HG_HARNESS/tools" --no-audit --no-fund --loglevel=error "@openai/codex@$VERSION"
got=$("$HG_HARNESS/tools/node_modules/.bin/codex" --version 2>/dev/null | tail -1 | cut -d' ' -f2)
[ "$got" = "$VERSION" ] || { echo "installed Codex $got, and $VERSION was wanted" >&2; exit 1; }

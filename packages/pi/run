#!/usr/bin/env python3
"""run: one turn of the Pi coding agent, for HarnessGateway. It reads a Responses request, gives Pi every field
of it that Pi has a flag or a setting for, and prints each thing Pi does as the Responses item or stream event
that says what it was. Pi's `--mode json` is the stream this is written from."""
import base64
import json
import os
import re
import signal
import subprocess
import sys
import urllib.request

HARNESS, TURN, STATE = os.environ["HG_HARNESS"], os.environ["HG_TURN"], os.environ["HG_STATE"]
AGENT = os.path.join(STATE, "agent")                   # Pi's config directory (models.json, mcp.json)
SESSIONS = os.path.join(STATE, "sessions")             # Pi's session storage
SESSION = os.path.join(STATE, "session")               # Pi's own id for this session
GIVEN = os.path.join("/tmp", "given-%d" % os.getpid())  # a file sent inside the request, put here for this turn
# What of a request this package acts on: the rest is named in the turn's log, so that nothing is ignored unsaid.
ACTED_ON = {"input", "instructions", "reasoning", "text", "tools", "tool_choice"}
THE_CORES = {"model", "previous_response_id", "stream", "background", "store", "metadata"}
# The provider APIs Pi speaks, in the order this package prefers them. Pi's own name for each API is in column 2.
APIS = (("HG_PROVIDER_ANTHROPIC", "anthropic-messages", "the Anthropic API"),
        ("HG_PROVIDER_OPENAI_RESPONSES", "openai-responses", "the OpenAI Responses API"),
        ("HG_PROVIDER_OPENAI_CHAT", "openai-completions", "the OpenAI Chat Completions API"),
        ("HG_PROVIDER_GEMINI", "google-generative-ai", "the Google Gemini API"))
EFFORTS = {"none": "off", "off": "off", "minimal": "minimal", "low": "low", "medium": "medium",
           "high": "high", "xhigh": "xhigh", "max": "max"}
FILE_TOOLS = ("write", "edit")


def say(line):
    print(json.dumps(line), flush=True)


def note(text):
    print(text, file=sys.stderr, flush=True)           # standard error is the turn's log


# the request


def saved(name, data):
    """Put the bytes of a file sent inside the request where Pi can be handed it with @path."""
    os.makedirs(GIVEN, exist_ok=True)
    path = os.path.join(GIVEN, os.path.basename(name) or "file")
    with open(path, "wb") as file:
        file.write(data)
    return path


def part_of(part, attached):
    """One part of a message, as the text of Pi's prompt, and any file it carries added to `attached`: Pi takes
    a file as an @path argument beside the prompt."""
    kind = part.get("type")
    if kind in ("input_text", "output_text"):
        return part.get("text", "")
    data = part.get("image_url") or part.get("file_data") or ""
    inline = re.fullmatch(r"data:([\w/+.-]+);base64,(.*)", data, re.S)
    if kind == "input_image" and inline:
        suffix = {"image/jpeg": ".jpg", "image/png": ".png", "image/gif": ".gif", "image/webp": ".webp"}.get(inline[1])
        attached.append(saved("image" + (suffix or ".bin"), base64.b64decode(inline[2])))
        return "(An image is attached to this request.)"
    if kind == "input_image" and part.get("image_url"):
        try:
            with urllib.request.urlopen(part["image_url"], timeout=15) as answer:
                attached.append(saved("image", answer.read()))
            return "(An image is attached to this request.)"
        except Exception as error:                     # a URL Pi cannot be handed as a file is still named
            note(f"could not fetch the image at {part['image_url']}: {error}")
            return f"(An image given with this request: {part['image_url']})"
    if kind == "input_file" and inline:
        path = saved(part.get("filename") or "file", base64.b64decode(inline[2]))
        attached.append(path)
        return f"A file given with this request is attached: {path}"
    if kind == "input_file" and part.get("file_data"):
        path = saved(part.get("filename") or "file", base64.b64decode(part["file_data"]))
        attached.append(path)
        return f"A file given with this request is attached: {path}"
    if kind == "input_file" and part.get("file_url"):
        return f"A file given with this request: {part['file_url']}"
    note(f"left alone: a part of type {kind}, which this package cannot give Pi")
    return ""


def asked(request):
    """The request's input as Pi takes it: the text of one prompt, the files that go beside it, and what a
    developer or the system said in the input, which is instructions."""
    given = request.get("input") or ""
    items = [{"role": "user", "content": given}] if isinstance(given, str) else given
    said, told, attached = [], [], []
    for item in items:
        if not isinstance(item, dict):
            note(f"left alone: an input item of type {type(item).__name__}")
            continue
        content, role = item.get("content"), item.get("role")
        if "content" not in item and item.get("type") in ("input_text", "input_image", "input_file"):
            content, role = [item], "user"            # a bare content part is something the person sent
        parts = [{"type": "input_text", "text": content}] if isinstance(content, str) else content or []
        rendered = [part_of(part, attached) for part in parts if isinstance(part, dict)]
        if role == "user":
            said += [text for text in rendered if text]
        elif role in ("developer", "system"):
            told += [text for text in rendered if text]
        elif role == "assistant":
            said.append("Earlier, you said: " + "\n".join(text for text in rendered if text))
        else:
            note(f"left alone: an input item of type {item.get('type') or role}")
    with open(os.path.join(TURN, "previous.json"), encoding="utf-8") as file:
        before = (json.load(file) or {}).get("status")
    prompt = "\n\n".join(said) or ("The file(s) for this request are attached." if attached else "")
    if before not in (None, "completed"):
        prompt = f"Your last turn did not finish: it ended as {before}.\n\n{prompt}"
    return prompt, attached, told


def provider():
    """The first API the provider speaks and Pi supports, and its base URL; or None."""
    for variable, api, said in APIS:
        if os.environ.get(variable):
            return os.environ[variable], api, said
    return None


def configured(request):
    """Pi's models.json and mcp.json for this turn. Pi has no flag for a base URL, an API or a tool server: they
    are its settings, written here under the session's mind."""
    os.makedirs(AGENT, exist_ok=True)
    base, api, name = provider()
    model = os.environ["HG_MODEL"]
    models = {"providers": {"hg": {
        "name": f"HarnessGateway ({name})", "baseUrl": base, "api": api,
        "apiKey": "$HG_PROVIDER_KEY",
        "models": [{"id": model, "name": model, "reasoning": True, "input": ["text", "image"],
                    "contextWindow": 128000, "maxTokens": 16384}]}}}
    with open(os.path.join(AGENT, "models.json"), "w", encoding="utf-8") as file:
        json.dump(models, file)
    servers = {}
    if request.get("tool_choice") == "none":
        note("tool_choice none: Pi runs with --no-tools --no-mcp, so it answers and does nothing")
    else:
        for tool in request.get("tools") or []:
            if tool.get("type") == "mcp" and tool.get("server_url"):
                label = tool.get("server_label") or "server"
                clean = re.sub(r"[^A-Za-z0-9_-]", "_", label)
                if clean != label:
                    note(f"a tool server named {label} is connected as {clean}: Pi allows letters, digits, _ and -")
                headers = {}
                if tool.get("authorization"):
                    headers["Authorization"] = f"Bearer {tool['authorization']}"
                headers.update(tool.get("headers") or {})
                entry = {"url": tool["server_url"], "exposure": "direct"}
                if headers:
                    entry["headers"] = headers
                servers[clean] = (label, entry)
            else:
                note(f"left alone: a tool of type {tool.get('type')}, which Pi cannot be given")
    with open(os.path.join(AGENT, "mcp.json"), "w", encoding="utf-8") as file:
        json.dump({"mcpServers": {clean: entry for clean, (_, entry) in servers.items()}}, file)
    if servers:
        return servers
    return {}


def mcp_states():
    """How each configured tool server is: `pi mcp list` connects to them, and says which did not connect."""
    try:
        listed = subprocess.run(
            [os.path.join(HARNESS, "tools", "node_modules", ".bin", "pi"), "mcp", "list", "--json"],
            env=pi_env(), capture_output=True, text=True, timeout=25)
        return {server["name"]: server for server in (json.loads(listed.stdout).get("servers") or [])}
    except Exception as error:
        note(f"could not ask Pi how its tool servers are: {error}")
        return {}


def pi_env():
    return {**os.environ, "PI_CODING_AGENT_DIR": AGENT, "PI_CODING_AGENT_SESSION_DIR": SESSIONS,
            "PI_OFFLINE": "1", "PI_TELEMETRY": "0"}


def command(request, prompt, attached, told):
    """Pi, headless, in JSON mode, with everything of the request it has a flag for."""
    args = [os.path.join(HARNESS, "tools", "node_modules", ".bin", "pi"),
            "-p", "--mode", "json",                          # one turn, then exit; JSONL on stdout
            "--provider", "hg", "--model", os.environ["HG_MODEL"],
            "--api-key", os.environ["HG_PROVIDER_KEY"],
            "--session-dir", SESSIONS,
            "--offline",                                     # no model-catalog refresh or other startup fetch
            "--no-approve"]                                  # no project-local resources without a person
    effort = (request.get("reasoning") or {}).get("effort")
    args += ["--thinking", EFFORTS[effort]] if effort in EFFORTS else ["--thinking", "off"]
    if effort is not None and effort not in EFFORTS:
        note(f"left alone: reasoning.effort {effort!r}, which is not a thinking level Pi knows")
    for key in (request.get("reasoning") or {}):
        if key != "effort":
            note(f"left alone: reasoning.{key}, which Pi has no flag for")
    instructions = "\n\n".join(part for part in [request.get("instructions"), *told] if part)
    if instructions:
        args += ["--append-system-prompt", instructions]     # given again each turn, so a continued session has it
    if request.get("tool_choice") == "none":
        args += ["--no-tools", "--no-mcp"]
    if os.path.exists(SESSION):
        with open(SESSION, encoding="utf-8") as file:
            args += ["--session-id", file.read().strip()]    # continue Pi's own session
    args.append("--")                                        # everything after is files and the prompt
    args += ["@" + path for path in attached]                # Pi attaches a file given with @path
    args.append(prompt)
    return args


# the response


def text_of(result):
    """A tool result's text: Pi gives a list of content blocks."""
    return "\n".join(block.get("text", "") for block in (result or {}).get("content") or []
                     if isinstance(block, dict) and block.get("type") == "text")


def edits_diff(edits):
    """A diff for an edit that failed before Pi could compute one: what it tried to take out and put in."""
    lines = []
    for edit in edits:
        lines += [f"-{line}" for line in str(edit.get("oldText", "")).splitlines()]
        lines += [f"+{line}" for line in str(edit.get("newText", "")).splitlines()]
    return "\n".join(lines) + ("\n" if lines else "")


def started(call_id, name, given, files):
    """A tool call Pi has just made, printed before it runs. A file change is held until its result, because
    Pi works out the diff while it makes the change."""
    if name == "bash":
        action = {"commands": [given.get("command", "")]}
        if given.get("timeout"):
            action["timeout_ms"] = int(float(given["timeout"]) * 1000)
        say({"type": "shell_call", "call_id": call_id, "status": "completed", "action": action})
    elif name in FILE_TOOLS:
        files[call_id] = {"name": name, "given": given,
                          "existed": os.path.exists(os.path.join(os.getcwd(), str(given.get("path", ""))))}
    elif name.startswith("mcp__") and name.count("__") >= 2:
        _, server, tool = name.split("__", 2)
        item = {"type": "mcp_call", "id": call_id, "server_label": server, "name": tool,
                "arguments": json.dumps(given), "status": "in_progress"}
        files[call_id] = item
        say({"type": "response.output_item.added", "item": item})
    else:
        say({"type": "custom_tool_call", "call_id": call_id, "name": name, "input": json.dumps(given)})


def returned(call_id, name, result, failed, held):
    """What came of a tool call: the item that answers it, or the end of the item it began."""
    output = text_of(result)
    if name == "bash":
        counted = (result or {}).get("structuredContent") or {}
        code = counted.get("exit_code")
        outcome = {"type": "exit", "exit_code": int(code) if isinstance(code, int) else 1}
        stdout = counted.get("output", output)
        if "Command timed out after" in output:
            outcome = {"type": "timeout"}
        say({"type": "shell_call_output", "call_id": call_id, "status": "completed",
             "output": [{"stdout": stdout, "stderr": "", "outcome": outcome}]})
    elif name in FILE_TOOLS:
        given = (held or {}).get("given") or {}
        path = str(given.get("path", ""))
        made = name == "write" and not (held or {}).get("existed")
        detail = (result or {}).get("details") or {}
        if name == "write":
            diff = "".join(f"+{line}\n" for line in str(given.get("content", "")).splitlines())
        else:
            diff = detail.get("patch") or detail.get("diff") or edits_diff(given.get("edits") or [])
        say({"type": "apply_patch_call", "call_id": call_id, "status": "completed", "operation": {
            "type": "create_file" if made else "update_file", "path": path, "diff": diff}})
        say({"type": "apply_patch_call_output", "call_id": call_id,
             "status": "failed" if failed else "completed", **({"output": output} if failed else {})})
    elif held and held.get("type") == "mcp_call":
        done = {**held, "status": "failed" if failed else "completed"}
        if failed:
            done["error"] = {"type": "mcp_tool_execution_error", "content": output}
        else:
            done["output"] = output
        say({"type": "response.output_item.done", "item": done})
    else:
        say({"type": "custom_tool_call_output", "call_id": call_id,
             "status": "failed" if failed else "completed", "output": output})


def tool_servers(servers, added, states):
    """Each tool server Pi started with, as the item that lists its tools, or says it did not connect."""
    found = {}
    for tool in added or []:
        name = tool.get("name") or ""
        if name.startswith("mcp__") and name.count("__") >= 2:
            _, server, tool_name = name.split("__", 2)
            found.setdefault(server, []).append({"name": tool_name, "input_schema": tool.get("parameters") or {}})
    for server, (label, _) in servers.items():
        tools = found.get(server, [])
        item = {"type": "mcp_list_tools", "server_label": label,
                "tools": tools or [{"name": tool, "input_schema": {}}
                                   for tool in (states.get(server) or {}).get("tools") or []]}
        state = states.get(server) or {}
        if state.get("state") not in (None, "connected"):
            item["error"] = state.get("error") or f"the server is {state.get('state')}"
        elif server not in found and not item["tools"]:
            item["error"] = "the server did not connect, or it lists no tools"
        say(item)


def ended(history, usage, aborted, failure):
    """The stream's last event: how the turn ended, and the tokens it used."""
    counted = {"input_tokens": usage["input"] + usage["cacheRead"] + usage["cacheWrite"],
               "output_tokens": usage["output"],
               "input_tokens_details": {"cached_tokens": usage["cacheRead"],
                                        "cache_write_tokens": usage["cacheWrite"]},
               "output_tokens_details": {"reasoning_tokens": usage["reasoning"]}}
    if failure:
        return {"type": "response.failed", "response": {"usage": counted, "error": {
            "code": "provider_error", "message": str(failure)[:2000]}}}
    if aborted:
        return {"type": "response.failed", "response": {"usage": counted, "error": {
            "code": "aborted", "message": "The turn was stopped before Pi finished. Send it again to continue."}}}
    if history.get("stopReason") == "length":
        return {"type": "response.incomplete", "response": {
            "usage": counted, "incomplete_details": {"reason": "max_output_tokens"}}}
    return {"type": "response.completed", "response": {"usage": counted}}


def main():
    with open(os.path.join(TURN, "request.json"), encoding="utf-8") as file:
        request = json.load(file)
    if provider() is None:                             # Pi speaks these APIs; the provider must speak one
        return say({"type": "response.failed", "response": {"error": {"code": "no_provider", "message": (
            "Pi needs a provider that speaks the Anthropic API, the OpenAI Responses API, the OpenAI Chat "
            "Completions API or the Google Gemini API: name one, as hg/provider/model.")}}})
    if unused := sorted(set(request) - ACTED_ON - THE_CORES):
        note(f"left alone: Pi has no flag or setting for {', '.join(unused)}")
    if request.get("tool_choice") not in (None, "none"):
        note(f"left alone: tool_choice {request['tool_choice']!r}; Pi acts with its tools without being told")
    prompt, attached, told = asked(request)
    servers = configured(request)
    states = mcp_states() if servers else {}
    args = command(request, prompt, attached, told)
    if request.get("text"):
        note("left alone: text.format, which Pi has no flag for: its final answer is its own prose")
    usage = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "reasoning": 0}
    signal.signal(signal.SIGTERM, lambda *_: None)     # a stopped turn: outlive Pi, so it saves its session
    cli = subprocess.Popen(args, env=pi_env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           text=True, errors="replace")
    held, history, aborted, failure, ended_by, listed = {}, {}, False, None, False, False
    for line in cli.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            note(line.rstrip())                        # not one of its events: something it printed aside
            continue
        kind = event.get("type")
        if kind == "session":
            os.makedirs(STATE, exist_ok=True)
            with open(SESSION, "w", encoding="utf-8") as file:
                file.write(event["id"])                # kept at once: a stopped turn is continued too
        elif kind == "message_start" and not listed and (event.get("message") or {}).get("role") == "system":
            listed = True
            tool_servers(servers, event["message"].get("toolsAdded"), states)
        elif kind == "message_update":
            update = event.get("assistantMessageEvent") or {}
            if update.get("type") == "text_delta":
                say({"type": "response.output_text.delta", "delta": update.get("delta", "")})
            elif update.get("type") == "thinking_delta":
                say({"type": "response.reasoning_summary_text.delta", "delta": update.get("delta", "")})
        elif kind == "message_end" and (event.get("message") or {}).get("role") == "assistant":
            message = event["message"]
            counted = message.get("usage") or {}
            for key in usage:
                usage[key] += int(counted.get(key) or 0)
            if message.get("stopReason") == "error":
                failure = message.get("errorMessage") or "Pi ended the turn with an error"
            else:
                failure = None                         # a retry that worked clears the failure before it
            history = message
        elif kind == "tool_execution_start":
            started(event.get("toolCallId"), event.get("toolName"), event.get("args") or {}, held)
        elif kind == "tool_execution_end":
            call_id = event.get("toolCallId")
            returned(call_id, event.get("toolName"), event.get("result"), bool(event.get("isError")),
                     held.pop(call_id, None))
        elif kind == "auto_retry_end" and not event.get("success"):
            failure = event.get("finalError") or "the provider could not be reached"
        elif kind == "auto_retry_start":
            note(f"Pi is retrying the model call ({event.get('attempt')}/{event.get('maxAttempts')}): "
                 f"{event.get('errorMessage')}")
        elif kind == "compaction_end" and event.get("errorMessage"):
            note(f"Pi could not compact its context: {event['errorMessage']}")
        elif kind == "agent_settled" and not ended_by:
            if servers and not listed:
                tool_servers(servers, [], states)      # no system message came, but the servers still existed
            aborted, ended_by = bool(event.get("aborted")), True
            say(ended(history, usage, aborted, failure))
    code = cli.wait()
    if not ended_by:
        if failure:
            say({"type": "response.failed", "response": {"usage": {
                "input_tokens": usage["input"] + usage["cacheRead"] + usage["cacheWrite"],
                "output_tokens": usage["output"]},
                "error": {"code": "provider_error", "message": str(failure)[:2000]}}})
        else:
            say({"type": "response.failed", "response": {"error": {
                "code": "cli_exit", "message": f"Pi exited with code {code} without finishing the turn."}}})


if __name__ == "__main__":
    main()
